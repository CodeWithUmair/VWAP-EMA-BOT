# Added 2026-09-01 alongside the handoff (repo had no .gitignore).
# Does not un-track files already committed upstream (e.g. trading_bot/__pycache__/*.pyc,
# trading_bot_data.sqlite) — it only stops new local noise from being committed.

venv/
.venv/
__pycache__/
*.pyc
.env
*.log

# per-account SQLite files if you run the multi-account setup
acct*.sqlite
vwap_*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# DB backups / restore side-copies (carry these by hand between machines)
backups/
trading_bot_data.sqlite.bak-*

# runtime DB (churns constantly; MT5 is source of truth)
trading_bot_data.sqlite

# Market data + calendar caches: large, regenerable, and machine-specific.
# Rebuild with:
#   python scripts/fetch_dukascopy_m1.py --from 2026-01-01 --to 2026-09-06 --out data/XAUUSD_M1_2026.csv
#   python -m trading_bot.news_filter
data/*.csv
data/news_events.json

# PIDs/logs from scripts/start_bot.ps1 - local runtime state, not source.
.run/
# Claude Code local tool-permission cache — machine-specific, not project config.
.claude/settings.json
